#!/usr/bin/env python3
"""Voice chat with an LLM on the AMD Ryzen AI NPU.

Speech recognition (whisper-large-v3-turbo) and generation (an LLM of your
choice) both run on the NPU through one FastFlowLM server. Recording,
resampling and optional speech synthesis use a little CPU.

Push to talk is Enter: press Enter to start recording, Enter again to stop.
Typing a line sends it as text instead.
"""

from __future__ import annotations

import argparse
import atexit
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import wave

PORT = int(os.environ.get("FLM_PORT", "52625"))
URL = f"http://127.0.0.1:{PORT}"
# ASR always talks to FastFlowLM (the NPU). The LLM may live elsewhere: any
# OpenAI-compatible server works, e.g. llama-server for a model FastFlowLM has
# no NPU build of. Set with --llm-url.
LLM_URL = URL
ASR_MODEL = os.environ.get("FLM_ASR_MODEL", "whisper-v3")
DEFAULT_LLM = os.environ.get("NPU_CHAT_MODEL", "gemma3:1b")
MIN_SECS = float(os.environ.get("NPU_CHAT_MIN_SECS", "0.4"))
DEFAULT_VOICE = os.environ.get("NPU_CHAT_VOICE", "en_GB-alan-medium")
# Silence threshold for trimming dead air off a capture. Measured on this box:
# room noise sits at about -19.5 dBFS and speech at -18.3, so the two overlap
# badly -- but silenceremove works on short windows, and the transcript survived
# every threshold tried (-40, -30, -25, -20 dB) on a padded sample. -30 dB is
# the conservative default; -25 dB cuts far more if you want it.
TRIM_DB = os.environ.get("NPU_CHAT_TRIM_DB", "-30dB")
LOGDIR = os.path.expanduser(
    os.environ.get("NPU_CHAT_LOGDIR", "~/.local/state/npu-chat")
)
VOICE_DIRS = (
    os.path.expanduser("~/.local/share/piper"),
    os.path.expanduser("~/.local/share/piper-voices"),
)

SYSTEM_PROMPT = (
    "You are a helpful voice assistant running locally on a laptop NPU. "
    "The user speaks to you, so keep replies short and conversational: "
    "two or three sentences unless asked for detail. Never use markdown."
)


def self_facts(model: str, voice: str | None, llm_on_npu: bool = True) -> str:
    """Tell the model what it actually is.

    Small models cannot know their own identity or where they run, and asking
    is a natural first thing to try by voice, so the truth is supplied rather
    than guessed at.
    """
    if llm_on_npu:
        bits = [
            f"you are the model {model}, served by FastFlowLM on an AMD Ryzen "
            "AI 9 365 (XDNA2) NPU",
            "speech recognition is whisper-large-v3-turbo, also on the NPU",
        ]
    else:
        bits = [
            f"you are the model {model}, served by llama.cpp on this laptop's "
            "CPU and RTX 4070 Laptop GPU, not on the NPU",
            "speech recognition is whisper-large-v3-turbo running on the AMD "
            "Ryzen AI 9 365 (XDNA2) NPU",
        ]
    if voice:
        bits.append(f"your voice is piper {voice}, which runs on the CPU")
    else:
        bits.append("you are not speaking out loud right now, replies are text only")
    return " Facts about yourself, use them if asked: " + "; ".join(bits) + "."

BOLD, DIM, CYAN, GREEN, YELLOW, RED, RESET = (
    "\033[1m", "\033[2m", "\033[36m", "\033[32m", "\033[33m", "\033[31m", "\033[0m"
)


_SESSION_DIR: str | None = None


def _cleanup() -> None:
    if _SESSION_DIR:
        shutil.rmtree(_SESSION_DIR, ignore_errors=True)


def _cleanup_and_die(signum, _frame):
    # atexit does not run on SIGHUP/SIGTERM, so closing the terminal used to
    # leave the whole session dir behind. Clean up, then exit properly.
    _cleanup()
    sys.exit(128 + signum)


def session_dir() -> str:
    """One temp dir per run, removed at exit, instead of one per turn."""
    global _SESSION_DIR
    if _SESSION_DIR is None:
        _SESSION_DIR = tempfile.mkdtemp(prefix="npu-chat-")
        atexit.register(_cleanup)
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            try:
                signal.signal(sig, _cleanup_and_die)
            except (ValueError, OSError):
                pass
    return _SESSION_DIR


class Transcript:
    """Append-only record of a session: JSONL for tools, .md for reading.

    Neither npu-chat nor the server kept reply text before this -- FastFlowLM
    logs only the final stream chunk, whose content is null -- so a finished
    conversation left nothing behind.
    """

    def __init__(self, path_stem: str) -> None:
        self.jsonl = path_stem + ".jsonl"
        self.md = path_stem + ".md"
        self._started = False

    def _start(self, meta: dict) -> None:
        with open(self.md, "a", encoding="utf-8") as fh:
            fh.write(f"# npu-chat session {meta['started']}\n\n")
            fh.write(f"- model: `{meta['model']}`\n")
            fh.write(f"- voice: `{meta['voice'] or 'none (text only)'}`\n")
            fh.write(f"- server: {meta['server']}\n\n")
        self._started = True

    def turn(self, meta: dict, **fields) -> None:
        if not self._started:
            self._start(meta)
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **fields}
        with open(self.jsonl, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        with open(self.md, "a", encoding="utf-8") as fh:
            if fields.get("user") is not None:
                via = fields.get("via", "text")
                extra = ""
                if fields.get("audio_secs"):
                    extra = f" _({fields['audio_secs']:.1f}s audio)_"
                fh.write(f"**you** ({via}){extra}: {fields['user']}\n\n")
            if fields.get("assistant") is not None:
                fh.write(f"**npu**: {fields['assistant']}\n\n")


def supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("TERM") not in (None, "dumb")


if not supports_color():
    BOLD = DIM = CYAN = GREEN = YELLOW = RED = RESET = ""


def server_up() -> bool:
    try:
        urllib.request.urlopen(f"{URL}/v1/models", timeout=2).read()
        return True
    except Exception:
        return False


def ensure_server() -> bool:
    if server_up():
        return True
    if not shutil.which("whisper-npu"):
        print(f"{RED}NPU server is down and whisper-npu is not on PATH.{RESET}")
        print(f"{DIM}Start it manually: flm serve --asr 1{RESET}")
        return False
    print(f"{DIM}starting NPU server (loading whisper + LLM on demand)...{RESET}")
    rc = subprocess.run(["whisper-npu", "--start"], capture_output=True).returncode
    return rc == 0 and server_up()


def record_until_enter() -> str | None:
    """Record from the default source until the user presses Enter."""
    if not shutil.which("pw-record"):
        print(f"{RED}pw-record not found (install pipewire-audio).{RESET}")
        return None
    tmp = session_dir()
    raw = os.path.join(tmp, "raw.wav")
    proc = subprocess.Popen(
        ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", raw],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(f"{RED}● recording{RESET} {DIM}- press Enter to stop{RESET}", end="", flush=True)
    started = time.time()
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass
    proc.send_signal(signal.SIGINT)
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
    held = time.time() - started
    print(f"\r\033[K{DIM}captured {held:.1f}s{RESET}")

    if not os.path.exists(raw) or os.path.getsize(raw) == 0:
        print(f"{YELLOW}no audio captured.{RESET}")
        return None
    if held < MIN_SECS:
        print(f"{YELLOW}too short ({held:.2f}s) - discarded.{RESET}")
        return None

    # pw-record leaves a stale length field when interrupted; normalise it.
    wav = os.path.join(tmp, "rec.wav")
    norm = subprocess.run(
        ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", raw,
         "-ar", "16000", "-ac", "1", wav],
        capture_output=True,
    )
    clip = wav if norm.returncode == 0 and os.path.exists(wav) else raw

    # Enter-to-start/Enter-to-stop records while the user thinks, so most of a
    # capture is dead air. Trimming it cuts what the NPU has to chew on; the
    # transcript was identical with and without on every threshold tested.
    trimmed = os.path.join(tmp, "trim.wav")
    cut = subprocess.run(
        ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", clip, "-af",
         f"silenceremove=start_periods=1:start_duration=0.1:"
         f"start_threshold={TRIM_DB}:stop_periods=-1:stop_duration=0.4:"
         f"stop_threshold={TRIM_DB}", "-ar", "16000", "-ac", "1", trimmed],
        capture_output=True,
    )
    if cut.returncode == 0:
        before, after = wav_duration(clip), wav_duration(trimmed)
        # Never hand over an empty clip just because the trim was greedy.
        if after and after >= MIN_SECS:
            if before:
                print(f"{DIM}trimmed {before:.1f}s -> {after:.1f}s{RESET}")
            clip = trimmed

    # Wall-clock time between Enter presses is not the audio length: a capture
    # that yields a header and no frames passes the check above and still
    # reaches the server as 0.00s. Gate on what is actually in the file.
    dur = wav_duration(clip)
    if dur is not None and dur < MIN_SECS:
        print(f"{YELLOW}only {dur:.2f}s of audio - discarded.{RESET}")
        return None
    return clip


def wav_duration(path: str) -> float | None:
    try:
        with wave.open(path, "rb") as w:
            return w.getnframes() / float(w.getframerate())
    except Exception:
        return None


def transcribe(path: str) -> str:
    """POST the clip to the NPU ASR endpoint (multipart, stdlib only)."""
    boundary = "----npuchat" + str(int(time.time() * 1000))
    with open(path, "rb") as fh:
        audio = fh.read()
    parts = [
        f"--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="file"; filename="clip.wav"\r\n',
        b"Content-Type: audio/wav\r\n\r\n",
        audio,
        f"\r\n--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="model"\r\n\r\n',
        ASR_MODEL.encode(),
        f"\r\n--{boundary}--\r\n".encode(),
    ]
    body = b"".join(parts)
    req = urllib.request.Request(
        f"{URL}/v1/audio/transcriptions",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=300).read())
    except Exception as exc:
        print(f"{RED}transcription failed: {exc}{RESET}")
        return ""
    return (d.get("text") or "").strip()


def stream_reply(model: str, history: list[dict]) -> tuple[str, float | None, float]:  # noqa: E501
    """Stream a chat completion from the NPU, printing tokens as they arrive."""
    body = json.dumps(
        {"model": model, "messages": history, "max_tokens": 512, "stream": True}
    ).encode()
    req = urllib.request.Request(
        f"{LLM_URL}/v1/chat/completions",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    out: list[str] = []
    first: float | None = None
    start = time.time()
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            print(f"{GREEN}{BOLD}npu{RESET} ", end="", flush=True)
            for line in resp:
                text = line.decode("utf-8", "replace").strip()
                if not text.startswith("data:"):
                    continue
                payload = text[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    chunk = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                delta = chunk["choices"][0].get("delta", {}).get("content")
                if not delta:
                    continue
                if first is None:
                    first = time.time() - start
                out.append(delta)
                sys.stdout.write(delta)
                sys.stdout.flush()
    except Exception as exc:
        print(f"\n{RED}generation failed: {exc}{RESET}")
        return "", None, time.time() - start
    reply = "".join(out).strip()
    total = time.time() - start
    if reply:
        ttft = f"{first:.2f}s" if first is not None else "n/a"
        print(f"\n{DIM}[{model} - first token {ttft}, total {total:.2f}s]{RESET}")
    else:
        print(f"{YELLOW}(empty reply){RESET}")
    return reply, first, total


def find_voice(name: str) -> str | None:
    """Resolve a piper voice id (or path) to an .onnx on disk."""
    if os.path.sep in name:
        return name if os.path.exists(name) else None
    if name.endswith(".onnx") and os.path.exists(name):
        return name
    stem = name[:-5] if name.endswith(".onnx") else name
    for d in VOICE_DIRS:
        candidate = os.path.join(d, stem + ".onnx")
        if os.path.exists(candidate):
            return candidate
    return None


def available_voices() -> list[str]:
    seen: list[str] = []
    for d in VOICE_DIRS:
        if not os.path.isdir(d):
            continue
        for f in sorted(os.listdir(d)):
            if f.endswith(".onnx") and f[:-5] not in seen:
                seen.append(f[:-5])
    return seen


def tts_ready() -> bool:
    return bool(shutil.which("piper-tts")) and bool(shutil.which("pw-play"))


def speak(text: str, voice_path: str) -> None:
    """Synthesise with piper-tts and play through the default sink.

    Do NOT pass --output-raw: it redirects audio to stdout and leaves -f empty,
    so playback gets silence. This bit us before.
    """
    text = text.strip()
    if not text:
        return
    wav = os.path.join(session_dir(), "reply.wav")
    try:
        subprocess.run(
            ["piper-tts", "-m", voice_path, "-f", wav],
            input=text.encode(),
            capture_output=True,
            check=True,
        )
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or b"").decode("utf-8", "replace").strip()
        print(f"{YELLOW}piper-tts failed: {detail[:200]}{RESET}")
        return
    except FileNotFoundError:
        print(f"{YELLOW}piper-tts not found.{RESET}")
        return
    subprocess.run(["pw-play", wav], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


HELP = f"""{BOLD}Commands{RESET}
  {CYAN}Enter{RESET}          push to talk - press Enter to start, Enter to stop
  type a line    send it as text instead of speaking
  {CYAN}/model NAME{RESET}    switch LLM (e.g. /model qwen3:4b)
  {CYAN}/models{RESET}        list models installed on this box
  {CYAN}/speak{RESET}         toggle spoken replies
  {CYAN}/voice NAME{RESET}    switch voice (e.g. /voice en_US-amy-medium)
  {CYAN}/voices{RESET}        list voices installed on this box
  {CYAN}/reset{RESET}         clear the conversation
  {CYAN}/help{RESET}          this list
  {CYAN}/quit{RESET}          exit"""


def installed_models() -> list[str]:
    if not shutil.which("flm"):
        return []
    out = subprocess.run(["flm", "list"], capture_output=True, text=True)
    names = []
    for line in out.stdout.splitlines():
        line = line.strip()
        if line.startswith("- ") and "✅" in line:
            names.append(line[2:].split()[0])
    return names


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Voice chat with an LLM on the AMD NPU (FastFlowLM).",
        epilog="Push to talk is Enter: press Enter to start recording, Enter again to stop.",
    )
    ap.add_argument("--model", default=DEFAULT_LLM,
                    help=f"LLM to chat with (default {DEFAULT_LLM})")
    ap.add_argument("--no-speak", action="store_true",
                    help="do not speak replies (text only)")
    ap.add_argument("--voice", default=DEFAULT_VOICE,
                    help=f"piper voice id or .onnx path (default {DEFAULT_VOICE})")
    ap.add_argument("--system", default=SYSTEM_PROMPT, help="override the system prompt")
    ap.add_argument("--llm-url", default=None,
                    help="OpenAI-compatible base URL for the LLM "
                         "(default: the NPU server; e.g. http://127.0.0.1:8080 "
                         "for llama-server)")
    ap.add_argument("--no-transcript", action="store_true",
                    help=f"do not write a session transcript under {LOGDIR}")
    args = ap.parse_args()

    global LLM_URL
    if args.llm_url:
        LLM_URL = args.llm_url.rstrip("/")
    if not ensure_server():
        return 1

    model = args.model
    voice_path = find_voice(args.voice)
    speaking = not args.no_speak
    if speaking and not tts_ready():
        missing = "piper-tts" if not shutil.which("piper-tts") else "pw-play"
        print(f"{YELLOW}spoken replies off: {missing} not found.{RESET}")
        speaking = False
    elif speaking and voice_path is None:
        print(f"{YELLOW}spoken replies off: voice {args.voice!r} not found in "
              f"{' or '.join(VOICE_DIRS)}.{RESET}")
        speaking = False

    def system_msg() -> dict:
        voice_id = (os.path.basename(voice_path)[:-5]
                    if speaking and voice_path else None)
        return {"role": "system",
                "content": args.system + self_facts(model, voice_id,
                                                    LLM_URL == URL)}

    history = [system_msg()]

    transcript = None
    if not args.no_transcript:
        os.makedirs(LOGDIR, exist_ok=True)
        stem = os.path.join(LOGDIR, time.strftime("%Y-%m-%dT%H-%M-%S"))
        transcript = Transcript(stem)

    def meta() -> dict:
        return {
            "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "model": model,
            "voice": (os.path.basename(voice_path)[:-5]
                      if speaking and voice_path else None),
            "server": URL,
        }

    if LLM_URL == URL:
        print(f"{BOLD}npu-chat{RESET} {DIM}- ASR and LLM both on the NPU "
              f"via {URL}{RESET}")
    else:
        print(f"{BOLD}npu-chat{RESET} {DIM}- ASR on the NPU via {URL}; "
              f"LLM via {LLM_URL}{RESET}")
    voice_note = (f"voice {os.path.basename(voice_path)[:-5]}"
                  if speaking and voice_path else "voice off")
    print(f"{DIM}model {model} | {voice_note} | press Enter to talk, "
          f"/help for commands{RESET}")
    if transcript:
        print(f"{DIM}transcript: {transcript.md}{RESET}")
    print()

    while True:
        try:
            line = input(f"{CYAN}{BOLD}you{RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0

        if line.startswith("/"):
            cmd, _, rest = line.partition(" ")
            cmd, rest = cmd.lower(), rest.strip()
            if cmd in ("/quit", "/exit", "/q"):
                return 0
            if cmd == "/help":
                print(HELP)
            elif cmd == "/reset":
                history = [system_msg()]
                print(f"{DIM}conversation cleared.{RESET}")
            elif cmd == "/models":
                names = installed_models()
                print(f"{DIM}installed: {', '.join(names) if names else 'unknown'}{RESET}")
            elif cmd == "/model":
                if not rest:
                    print(f"{DIM}current model: {model}{RESET}")
                else:
                    model = rest
                    history[0] = system_msg()
                    print(f"{DIM}model set to {model} "
                          f"(loads on first use){RESET}")
            elif cmd == "/speak":
                if not tts_ready():
                    print(f"{YELLOW}piper-tts or pw-play is missing.{RESET}")
                elif voice_path is None:
                    print(f"{YELLOW}no voice loaded - use /voice NAME.{RESET}")
                else:
                    speaking = not speaking
                    history[0] = system_msg()
                    print(f"{DIM}spoken replies {'on' if speaking else 'off'}.{RESET}")
            elif cmd == "/voices":
                names = available_voices()
                print(f"{DIM}voices: {', '.join(names) if names else 'none found'}{RESET}")
            elif cmd == "/voice":
                if not rest:
                    current = os.path.basename(voice_path)[:-5] if voice_path else "none"
                    print(f"{DIM}current voice: {current}{RESET}")
                else:
                    found = find_voice(rest)
                    if found is None:
                        print(f"{YELLOW}voice {rest!r} not found - /voices to list{RESET}")
                    else:
                        voice_path = found
                        speaking = tts_ready()
                        history[0] = system_msg()
                        print(f"{DIM}voice set to {rest}.{RESET}")
            else:
                print(f"{YELLOW}unknown command {cmd} - try /help{RESET}")
            continue

        audio_secs = None
        via = "text"
        if line == "":
            clip = record_until_enter()
            if not clip:
                continue
            audio_secs = wav_duration(clip)
            said = transcribe(clip)
            if not said:
                print(f"{YELLOW}nothing transcribed.{RESET}")
                continue
            print(f"{CYAN}{BOLD}you{RESET} {said}")
            user_text = said
            via = "voice"
        else:
            user_text = line

        history.append({"role": "user", "content": user_text})
        reply, ttft, total = stream_reply(model, history)
        if reply:
            history.append({"role": "assistant", "content": reply})
            if speaking and voice_path:
                speak(reply, voice_path)
        else:
            history.pop()
        if transcript:
            transcript.turn(meta(), via=via, user=user_text, assistant=reply or None,
                            audio_secs=audio_secs, model=model,
                            ttft_secs=round(ttft, 3) if ttft else None,
                            total_secs=round(total, 3))
        print()


if __name__ == "__main__":
    sys.exit(main())
