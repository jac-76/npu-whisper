DEFAULT_VOICE = os.environ.get("NPU_CHAT_VOICE", "en_GB-alan-medium")
# Silence threshold for trimming dead air off a capture. Measured on this box:
# room noise sits at about -19.5 dBFS and speech at -18.3, so the two overlap
# badly -- but silenceremove works on short windows, and the transcript survived
# every threshold tried (-40, -30, -25, -20 dB) on a padded sample. -30 dB is
# the conservative default; -25 dB cuts far more if you want it.
TRIM_DB = os.environ.get("NPU_CHAT_TRIM_DB", "-30dB")
# Speech gate (Silero VAD) ahead of whisper, which invents sentences from room
# noise. Calibrated on this mic, peak speech probability per capture:
#   room noise x6        0.011 - 0.074   (whisper still wrote "Thank you." etc.)
#   quiet speech x3      0.163 - 0.414   (whisper transcribed it correctly)
#   normal speech x3     0.954 - 0.997
# Silero's usual 0.5 would have thrown the quiet speech away, so a capture is
# kept if any 32 ms frame reaches VAD_MIN, set between the two groups.
VAD_MODEL = os.path.expanduser(os.environ.get(
    "NPU_CHAT_VAD_MODEL", "~/.local/share/silero-vad/silero_vad.onnx"))
VAD_MIN = float(os.environ.get("NPU_CHAT_VAD_MIN", "0.12"))
VAD_ON = os.environ.get("NPU_CHAT_VAD", "1") != "0"
# What the last capture's speech check found; the loop logs it per turn so
