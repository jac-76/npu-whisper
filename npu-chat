def llm_where_default(llm_url: str) -> str:
    """Where a non-NPU LLM runs, without claiming hardware we cannot see."""
    host = urllib.parse.urlsplit(llm_url).hostname or llm_url
    if host in ("127.0.0.1", "localhost", "::1"):
        return "this laptop"
    return f"a separate machine at {host}"


# --- tools the chat model can call (ollama only) ------------------------------
# qwen3.5 on ollama returned real tool calls in every probe; FastFlowLM's
# gemma3:1b ignored them and invented results, so tools are offered only to
# ollama. Web search goes to a local SearXNG; grow status reads the snapshots
# the grow daemons already cache (`<tool> bar`), never polling the cloud APIs:
# AC Infinity answers extra polling with 403.

SEARX_URL = os.environ.get("NPU_CHAT_SEARX_URL", "http://127.0.0.1:8888")
MAX_TOOL_ROUNDS = 3
GROW_TOOLS = (("acinf", "AC Infinity controller"),
              ("vivosun", "VIVOSUN GrowHub"),
              ("yinmik", "YINMIK reservoir meter"))

TOOLS = [
