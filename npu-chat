def tools_for(today: time.struct_time | None = None) -> list[dict]:
    """TOOLS with the current year written into the search description."""
    year = str((today or time.localtime()).tm_year)
    out = json.loads(json.dumps(TOOLS))
    fn = out[0]["function"]
    fn["description"] = fn["description"].replace("{year}", year)
    return out


