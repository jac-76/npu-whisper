def web_search(query: str, n: int = 8) -> str:
    url = f"{SEARX_URL}/search?" + urllib.parse.urlencode({"q": query, "format": "json"})
    try:
        d = json.loads(urllib.request.urlopen(url, timeout=15).read())
    except Exception as exc:
        return f"web search failed: {exc}"
    results = d.get("results") or []
    lines = []
    # SearXNG's direct answers and infoboxes, when an engine gives one, are the
    # most specific thing it returns; put them first.
    for a in d.get("answers") or []:
        text = a.get("answer") if isinstance(a, dict) else str(a)
        if text:
            lines.append(f"Answer: {' '.join(str(text).split())[:300]}")
    for box in (d.get("infoboxes") or [])[:1]:
        body = " ".join((box.get("content") or "").split())[:400]
        if body:
            lines.append(f"Infobox ({box.get('infobox', '')}): {body}")
    if not results and not lines:
        down = [f"{e[0]}: {e[1]}" for e in d.get("unresponsive_engines") or []
                if isinstance(e, (list, tuple)) and len(e) >= 2]
        if down:
            # Measured: every engine suspended after heavy use left "no results"
            # for everything, and the model then told the user nothing existed.
            return ("SEARCH UNAVAILABLE - the search engines are refusing requests "
                    f"right now ({'; '.join(down)}). Tell the user web search is "
                    "down; do not say the thing could not be found.")
        return "no results"
    for i, r in enumerate(results[:n], 1):
        snippet = " ".join((r.get("content") or "").split())[:300]
        lines.append(f"{i}. {r.get('title', '').strip()} - {r.get('url', '')}\n   {snippet}")
    return "\n".join(lines)


def grow_status() -> str:
    out = []
    for cmd, label in GROW_TOOLS:
        if not shutil.which(cmd):
            out.append(f"{label}: not installed")
            continue
        try:
            r = subprocess.run([cmd, "bar"], capture_output=True, text=True, timeout=10)
            # The bar JSON carries raw newlines inside strings; strict=False takes them.
            d = json.loads(r.stdout.strip(), strict=False)
            out.append((d.get("tooltip") or d.get("text") or "").strip())
        except Exception as exc:
            out.append(f"{label}: unavailable ({exc})")
    return "\n".join(out)


# Asked about the grow -> fetch the readings ourselves. Left to qwen3.5:9b,
# 1 of 3 runs answered "I can't see real-time grow room readings" without
# calling grow_status, and later turns reused an old result instead of
# re-reading. The tool stays for phrasings this list misses.
GROW_WORDS = re.compile(
    r"\b(grow|tent|reservoir|res|ph|ec|ppm|tds|humidity|humid|rh|vpd|"
    r"temperature|temp|plants?|fans?|light|nutrients?|water)\b", re.I)


def with_grow_context(text: str) -> tuple[str, bool]:
    """User message plus fresh grow readings when the grow is mentioned."""
    if not GROW_WORDS.search(text):
        return text, False
    return (f"{text}\n\n[Grow readings fetched just now - use these, they are "
            f"current]\n{grow_status()}"), True


# Questions about the present -> search first, ourselves. The search-routing
# eval (8 verified 2026 facts x 3 runs) scored 13/24 when qwen3.5:9b decided
# alone: it answered "Jerome Powell" for Fed chair 3/3 without searching.
CURRENT_WORDS = re.compile(
    r"\b(latest|most recent|recent|recently|current|currently|right now|today|"
    r"tonight|yesterday|this (year|season|week|month|weekend)|last (night|week)|"
    r"who won|who is the|who's the|news|price of|prices|score|standings|"
    r"next (game|match|race|election))\b", re.I)


def search_query_for(text: str, year: int) -> str:
    """The user's own words as the query, with the year added if missing."""
    q = " ".join(text.split())
    return q if re.search(r"\b(19|20)\d\d\b", q) else f"{q} {year}"


def with_search_context(text: str, year: int) -> tuple[str, str | None]:
    if not CURRENT_WORDS.search(text):
        return text, None
    q = search_query_for(text, year)
    return (f"{text}\n\n[Web results for '{q}', fetched just now. They are newer "
            f"than your training; answer from them and name the site]\n"
            f"{web_search(q)}"), q


def describe_call(name: str, args: dict) -> str:
    if name == "web_search":
        return f"searching: {args.get('query', '')}"
    if name == "grow_status":
        return "reading grow status"
    return f"{name} {json.dumps(args)}"


def run_tool(name: str, raw_args: str) -> tuple[dict, str]:
    try:
        args = json.loads(raw_args or "{}")
        if not isinstance(args, dict):
            args = {}
    except json.JSONDecodeError:
        return {}, f"could not parse arguments: {raw_args!r}"
    if name == "web_search":
        q = str(args.get("query") or "").strip()
        return args, web_search(q) if q else "empty query"
    if name == "grow_status":
        return args, grow_status()
    return args, f"unknown tool {name}"


def latest_chat_log(logdir: str) -> str | None:
    """Newest chat-mode session JSONL with at least one answered turn.

    Agent-mode sessions log a Claude Code session_id per turn; they are not
    chat history and are skipped.
    """
    import glob

    paths = sorted(glob.glob(os.path.join(logdir, "*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    for path in paths:
        try:
            recs = [json.loads(x) for x in open(path, encoding="utf-8") if x.strip()]
        except (OSError, json.JSONDecodeError):
            continue
        if any("session_id" in r for r in recs):
            continue
        if any(r.get("user") and r.get("assistant") for r in recs):
            return path
    return None


def history_from_log(path: str) -> list[dict]:
    """The user/assistant turns of a session; discarded and failed turns skipped."""
    msgs: list[dict] = []
    for line in open(path, encoding="utf-8"):
        if not line.strip():
            continue
        r = json.loads(line)
        if r.get("user") and r.get("assistant") and r.get("sent", True):
            msgs.append({"role": "user", "content": r["user"]})
            msgs.append({"role": "assistant", "content": r["assistant"]})
    return msgs


def chat_turn(model: str, history: list[dict], user_text: str,
              server: str | None, tools_on: bool, on_delta=None,
              log=print) -> tuple[str, float | None, list[dict], bool]:
    """One user turn, tool calls included. Mutates `history`.

    Returns (reply, time to first text, tools used, grow readings attached).
    On an empty reply the caller rolls history back.
    """
    content, grow_attached = (with_grow_context(user_text) if tools_on
                              else (user_text, False))
    if grow_attached:
        log(f"{DIM}· reading grow status{RESET}")
    used: list[dict] = []
    if tools_on:
        year = time.localtime().tm_year
        if CURRENT_WORDS.search(user_text):
            log(f"{DIM}· searching: {search_query_for(user_text, year)}{RESET}")
            if on_delta:
                on_delta("Let me check. ")
        content, q = with_search_context(content, year)
        if q:
            used.append({"name": "web_search", "args": {"query": q}, "auto": True})
    history.append({"role": "user", "content": content})
    t_turn = time.time()
    ttft = None
    reply = ""
    for round_ in range(MAX_TOOL_ROUNDS + 1):
        calls: list[dict] = []
        offer = tools_for() if tools_on and round_ < MAX_TOOL_ROUNDS else None
        t_round = time.time()
        reply, r_ttft, _ = stream_reply(model, history, server, on_delta=on_delta,
                                        tools=offer, calls_out=calls)
        if r_ttft is not None and ttft is None:
            ttft = (t_round - t_turn) + r_ttft
        if not calls:
            break
        if on_delta and not used:
            on_delta("Let me check. ")    # something to hear while it looks
        history.append({"role": "assistant", "content": reply or "",
                        "tool_calls": [
                            {"id": c["id"] or f"call_{round_}_{i}", "type": "function",
                             "function": {"name": c["name"],
                                          "arguments": c["arguments"] or "{}"}}
                            for i, c in enumerate(calls)]})
        for i, c in enumerate(calls):
            try:
                preview = json.loads(c["arguments"] or "{}")
            except json.JSONDecodeError:
                preview = {}
            log(f"{DIM}· {describe_call(c['name'], preview if isinstance(preview, dict) else {})}{RESET}")
            args_used, result = run_tool(c["name"], c["arguments"])
            used.append({"name": c["name"], "args": args_used})
            history.append({"role": "tool",
                            "tool_call_id": c["id"] or f"call_{round_}_{i}",
                            "content": result})
    return reply, ttft, used, grow_attached


def prewarm(llm_url: str, model: str, server: str | None) -> None:
    """Ask ollama to load the model now, in the background.

    A cold model costs ~5 s on the first reply; loading it while the user is
    still reading the banner hides that. An /api/generate request with no
    prompt loads the model without generating anything. ollama only.
    """
    if server != "ollama":
        return
    import threading

    def go():
        try:
            req = urllib.request.Request(
                f"{llm_url}/api/generate",
                data=json.dumps({"model": model}).encode(),
                headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=120).read()
        except Exception:
            pass    # the first real turn will surface any problem
    threading.Thread(target=go, daemon=True).start()


def llm_server_kind(llm_url: str) -> str | None:
    """Name the server behind an OpenAI-compatible URL, if it says."""
    probes = (("/api/version", "ollama", "version"),
              ("/props", "llama.cpp", "default_generation_settings"))
    for path, name, key in probes:
        try:
            d = json.loads(urllib.request.urlopen(llm_url + path, timeout=3).read())
        except Exception:
            continue
        if isinstance(d, dict) and key in d:
            return name
    return None


def self_facts(model: str, voice: str | None, llm_on_npu: bool = True,
               server: str | None = None, where: str | None = None) -> str:
    """Tell the model what it actually is.

    Small models cannot know their own identity or where they run, and asking
    is a natural first thing to try by voice, so the truth is supplied rather
    than guessed at.
    """
    if llm_on_npu:
        bits = [
            f"you are the model {model}, served by FastFlowLM on an AMD Ryzen "
            "AI 9 365 (XDNA2) NPU",
            "speech recognition is whisper-large-v3-turbo, also on the NPU",
        ]
    else:
        bits = [
            f"you are the model {model}, served by "
            f"{server or 'an OpenAI-compatible server'} on "
            f"{where or 'another machine'}, not on the NPU",
            "speech recognition is whisper-large-v3-turbo running on this "
            "laptop's AMD Ryzen AI 9 365 (XDNA2) NPU",
        ]
    if voice:
        bits.append(f"your voice is piper {voice}, which runs on the CPU")
    else:
        bits.append("you are not speaking out loud right now, replies are text only")
    return " Facts about yourself, use them if asked: " + "; ".join(bits) + "."

BOLD, DIM, CYAN, GREEN, YELLOW, RED, RESET = (
    "\033[1m", "\033[2m", "\033[36m", "\033[32m", "\033[33m", "\033[31m", "\033[0m"
)


_SESSION_DIR: str | None = None


def _cleanup() -> None:
    if _SESSION_DIR:
        shutil.rmtree(_SESSION_DIR, ignore_errors=True)


def _cleanup_and_die(signum, _frame):
    # atexit does not run on SIGHUP/SIGTERM, so closing the terminal used to
    # leave the whole session dir behind. Clean up, then exit properly.
    _cleanup()
    sys.exit(128 + signum)


def session_dir() -> str:
    """One temp dir per run, removed at exit, instead of one per turn."""
    global _SESSION_DIR
    if _SESSION_DIR is None:
        _SESSION_DIR = tempfile.mkdtemp(prefix="npu-chat-")
        atexit.register(_cleanup)
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            try:
                signal.signal(sig, _cleanup_and_die)
            except (ValueError, OSError):
                pass
    return _SESSION_DIR


class Transcript:
    """Append-only record of a session: JSONL for tools, .md for reading.

    Neither npu-chat nor the server kept reply text before this -- FastFlowLM
    logs only the final stream chunk, whose content is null -- so a finished
    conversation left nothing behind.
    """

    def __init__(self, path_stem: str) -> None:
        self.jsonl = path_stem + ".jsonl"
        self.md = path_stem + ".md"
        self._started = False

    def _start(self, meta: dict) -> None:
        with open(self.md, "a", encoding="utf-8") as fh:
            fh.write(f"# npu-chat session {meta['started']}\n\n")
            fh.write(f"- model: `{meta['model']}`\n")
            fh.write(f"- voice: `{meta['voice'] or 'none (text only)'}`\n")
            fh.write(f"- server: {meta['server']}\n\n")
        self._started = True

    def turn(self, meta: dict, **fields) -> None:
        if not self._started:
            self._start(meta)
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **fields}
        with open(self.jsonl, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        with open(self.md, "a", encoding="utf-8") as fh:
            if fields.get("user") is not None:
                via = fields.get("via", "text")
                extra = ""
                if fields.get("audio_secs"):
                    extra = f" _({fields['audio_secs']:.1f}s audio)_"
                fh.write(f"**you** ({via}){extra}: {fields['user']}\n\n")
            if fields.get("assistant") is not None:
                fh.write(f"**npu**: {fields['assistant']}\n\n")


def supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("TERM") not in (None, "dumb")


if not supports_color():
    BOLD = DIM = CYAN = GREEN = YELLOW = RED = RESET = ""


def server_up() -> bool:
    try:
        urllib.request.urlopen(f"{URL}/v1/models", timeout=2).read()
        return True
    except Exception:
        return False


def ensure_server() -> bool:
    if server_up():
        return True
    if not shutil.which("whisper-npu"):
        print(f"{RED}NPU server is down and whisper-npu is not on PATH.{RESET}")
        print(f"{DIM}Start it manually: flm serve --asr 1{RESET}")
        return False
    print(f"{DIM}starting NPU server (loading whisper + LLM on demand)...{RESET}")
    rc = subprocess.run(["whisper-npu", "--start"], capture_output=True).returncode
    return rc == 0 and server_up()


def record_until_enter() -> str | None:
    """Record from the default source until the user presses Enter."""
    if not shutil.which("pw-record"):
        print(f"{RED}pw-record not found (install pipewire-audio).{RESET}")
        return None
    tmp = session_dir()
    raw = os.path.join(tmp, "raw.wav")
    proc = subprocess.Popen(
        ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", raw],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(f"{RED}● recording{RESET} {DIM}- press Enter to stop{RESET}", end="", flush=True)
    started = time.time()
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass
    proc.send_signal(signal.SIGINT)
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
    held = time.time() - started
    print(f"\r\033[K{DIM}captured {held:.1f}s{RESET}")

    if not os.path.exists(raw) or os.path.getsize(raw) == 0:
        print(f"{YELLOW}no audio captured.{RESET}")
        return None
    if held < MIN_SECS:
        print(f"{YELLOW}too short ({held:.2f}s) - discarded.{RESET}")
        return None

    # pw-record leaves a stale length field when interrupted; normalise it.
    wav = os.path.join(tmp, "rec.wav")
    norm = subprocess.run(
        ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", raw,
         "-ar", "16000", "-ac", "1", wav],
        capture_output=True,
    )
    clip = wav if norm.returncode == 0 and os.path.exists(wav) else raw

    LAST_CAPTURE.clear()
    peak = vad_peak(clip) if VAD_ON else None
    if peak is not None:
        LAST_CAPTURE["vad_max_p"] = round(peak, 3)
        if peak < VAD_MIN:
            LAST_CAPTURE["vad_discarded"] = True
            print(f"{YELLOW}no speech detected (peak {peak:.2f} < {VAD_MIN}) "
                  f"- discarded.{RESET}")
            return None

    # Enter-to-start/Enter-to-stop records while the user thinks, so most of a
    # capture is dead air. Trimming it cuts what the NPU has to chew on; the
    # transcript was identical with and without on every threshold tested.
    trimmed = os.path.join(tmp, "trim.wav")
    cut = subprocess.run(
        ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", clip, "-af",
         f"silenceremove=start_periods=1:start_duration=0.1:"
         f"start_threshold={TRIM_DB}:stop_periods=-1:stop_duration=0.4:"
         f"stop_threshold={TRIM_DB}", "-ar", "16000", "-ac", "1", trimmed],
        capture_output=True,
    )
    if cut.returncode == 0:
        before, after = wav_duration(clip), wav_duration(trimmed)
        # Never hand over an empty clip just because the trim was greedy.
        if after and after >= MIN_SECS:
            if before:
                print(f"{DIM}trimmed {before:.1f}s -> {after:.1f}s{RESET}")
            clip = trimmed

    # Wall-clock time between Enter presses is not the audio length: a capture
    # that yields a header and no frames passes the check above and still
    # reaches the server as 0.00s. Gate on what is actually in the file.
    dur = wav_duration(clip)
    if dur is not None and dur < MIN_SECS:
        print(f"{YELLOW}only {dur:.2f}s of audio - discarded.{RESET}")
        return None
    return clip


_VAD = {"session": None, "warned": False}


def vad_probs(path: str) -> list[float] | None:
    """Silero VAD speech probability per 32 ms frame of a 16 kHz mono WAV.

    None when the model or onnxruntime is unavailable - then nothing is
    filtered, which is how npu-chat behaved before the gate existed.
    """
    if _VAD["session"] is None:
        try:
            import numpy  # noqa: F401
            import onnxruntime as ort
            if not os.path.exists(VAD_MODEL):
                raise FileNotFoundError(VAD_MODEL)
            _VAD["session"] = ort.InferenceSession(
                VAD_MODEL, providers=["CPUExecutionProvider"])
        except Exception as exc:
            if not _VAD["warned"]:
                print(f"{DIM}speech gate off ({exc}); noise is not filtered. "
                      f"See README, Silero VAD.{RESET}")
                _VAD["warned"] = True
            return None
    import numpy as np

    try:
        with wave.open(path, "rb") as w:
            if w.getframerate() != 16000 or w.getnchannels() != 1:
                return None
            x = np.frombuffer(w.readframes(w.getnframes()),
                              dtype=np.int16).astype(np.float32) / 32768
    except Exception:
        return None
    sess = _VAD["session"]
    state = np.zeros((2, 1, 128), np.float32)
    ctx = np.zeros((1, 64), np.float32)          # Silero v5+ wants 64 samples of context
    sr = np.array(16000, np.int64)
    out = []
    for i in range(0, len(x) - 511, 512):
        inp = np.concatenate([ctx, x[None, i:i + 512]], axis=1)
        p, state = sess.run(None, {"input": inp, "state": state, "sr": sr})
        ctx = inp[:, -64:]
        out.append(float(p[0, 0]))
    return out


def vad_peak(path: str) -> float | None:
    probs = vad_probs(path)
    if probs is None:
        return None
    return max(probs) if probs else 0.0


def wav_duration(path: str) -> float | None:
    try:
        with wave.open(path, "rb") as w:
            return w.getnframes() / float(w.getframerate())
    except Exception:
        return None


def transcribe(path: str) -> str:
    """POST the clip to the NPU ASR endpoint (multipart, stdlib only)."""
    boundary = "----npuchat" + str(int(time.time() * 1000))
    with open(path, "rb") as fh:
        audio = fh.read()
    parts = [
        f"--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="file"; filename="clip.wav"\r\n',
        b"Content-Type: audio/wav\r\n\r\n",
        audio,
        f"\r\n--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="model"\r\n\r\n',
        ASR_MODEL.encode(),
        f"\r\n--{boundary}--\r\n".encode(),
    ]
    body = b"".join(parts)
    req = urllib.request.Request(
        f"{URL}/v1/audio/transcriptions",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=300).read())
    except Exception as exc:
        print(f"{RED}transcription failed: {exc}{RESET}")
        return ""
    return (d.get("text") or "").strip()


def request_body(model: str, history: list[dict], server: str | None) -> dict:
    body = {"model": model, "messages": history, "max_tokens": 512, "stream": True}
    if server == "ollama":
        # Qwen3.5 on ollama thinks by default and spent the whole 512-token
        # budget on it: empty content, finish_reason=length, 5/5 word problems
        # "unanswered". Measured: reasoning_effort="none" gives 0 reasoning
        # chars; think:false and chat_template_kwargs are ignored on /v1.
        body["reasoning_effort"] = "none"
    return body


def stream_reply(model: str, history: list[dict], server: str | None = None,
                 on_delta=None, tools: list[dict] | None = None,
                 calls_out: list | None = None) -> tuple[str, float | None, float]:
    """Stream a chat completion, printing tokens as they arrive.

    on_delta gets each piece of text too, so speech can start on the first
    sentence instead of waiting for the whole reply. With `tools`, any tool
    calls the model makes are collected into `calls_out`.
    """
    payload_body = request_body(model, history, server)
    if tools:
        payload_body["tools"] = tools
    body = json.dumps(payload_body).encode()
    req = urllib.request.Request(
        f"{LLM_URL}/v1/chat/completions",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    out: list[str] = []
    first: float | None = None
    start = time.time()
    partial: dict[int, dict] = {}
    labelled = False
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            for line in resp:
                text = line.decode("utf-8", "replace").strip()
                if not text.startswith("data:"):
                    continue
                payload = text[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    chunk = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                d = chunk["choices"][0].get("delta", {})
                for tc in d.get("tool_calls") or []:
                    # ollama sends each call whole; OpenAI-style servers send
                    # the arguments in fragments keyed by index. Merge both.
                    slot = partial.setdefault(tc.get("index", len(partial)),
                                              {"id": "", "name": "", "arguments": ""})
                    slot["id"] = tc.get("id") or slot["id"]
                    fn = tc.get("function") or {}
                    slot["name"] = fn.get("name") or slot["name"]
                    slot["arguments"] += fn.get("arguments") or ""
                delta = d.get("content")
                if not delta:
                    continue
                if first is None:
                    first = time.time() - start
                if not labelled:
                    print(f"{GREEN}{BOLD}npu{RESET} ", end="", flush=True)
                    labelled = True
                out.append(delta)
                sys.stdout.write(delta)
                sys.stdout.flush()
                if on_delta:
                    on_delta(delta)
    except Exception as exc:
        print(f"\n{RED}generation failed: {exc}{RESET}")
        if LLM_URL != URL:
            print(f"{DIM}LLM is {LLM_URL}; drop --llm-url / NPU_CHAT_LLM_URL "
                  f"to use the NPU.{RESET}")
        return "", None, time.time() - start
    reply = "".join(out).strip()
    total = time.time() - start
    if calls_out is not None:
        calls_out.extend(partial[i] for i in sorted(partial))
    if partial and not reply:
        return reply, first, total
    if reply:
        ttft = f"{first:.2f}s" if first is not None else "n/a"
        print(f"\n{DIM}[{model} - first token {ttft}, total {total:.2f}s]{RESET}")
    else:
        print(f"{YELLOW}(empty reply){RESET}")
    return reply, first, total


def find_voice(name: str) -> str | None:
    """Resolve a piper voice id (or path) to an .onnx on disk."""
    if os.path.sep in name:
        return name if os.path.exists(name) else None
    if name.endswith(".onnx") and os.path.exists(name):
        return name
    stem = name[:-5] if name.endswith(".onnx") else name
    for d in VOICE_DIRS:
        candidate = os.path.join(d, stem + ".onnx")
        if os.path.exists(candidate):
            return candidate
    return None


def available_voices() -> list[str]:
    seen: list[str] = []
    for d in VOICE_DIRS:
        if not os.path.isdir(d):
            continue
        for f in sorted(os.listdir(d)):
            if f.endswith(".onnx") and f[:-5] not in seen:
                seen.append(f[:-5])
    return seen


def tts_ready() -> bool:
    return bool(shutil.which("piper-tts")) and bool(shutil.which("pw-play"))


def for_speech(text: str) -> str:
    """Strip markup that a synthesiser would read out loud.

    piper pronounces the characters: "You now have **7** apples." came out as
    "You now have asterisk-sterisk-seven asterisk-ster apples", 4.23s instead of
    1.96s. Models emit markdown even when the system prompt forbids it.
    """
    t = text
    t = re.sub(r"```[\s\S]*?```", " ", t)          # fenced code
    t = re.sub(r"`([^`]*)`", r"\1", t)              # inline code
    t = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", t)  # links/images
    t = re.sub(r"(\*\*|__)(.*?)\1", r"\2", t)      # bold
    t = re.sub(r"(?<!\w)[*_](\S(?:.*?\S)?)[*_](?!\w)", r"\1", t)  # italics
    t = re.sub(r"^\s{0,3}#{1,6}\s*", "", t, flags=re.M)  # headings
    t = re.sub(r"^\s*[-*+]\s+", "", t, flags=re.M)       # bullets
    t = re.sub(r"^\s*>\s?", "", t, flags=re.M)           # quotes
    t = re.sub(r"[ \t]{2,}", " ", t)
    return t.strip()


class SentenceSplitter:
    """Cut streamed text into speakable pieces as soon as each one is complete.

    A piece ends at . ! or ? followed by whitespace, or at a newline, so
    "3.5" and "e.g" mid-word never split. Fenced code is dropped whole:
    piper reading a code block aloud is never what anyone wants.
    """

    _END = re.compile(r"[.!?][\"')\]]*\s+|\n+")

    def __init__(self) -> None:
        self._buf = ""
        self._in_fence = False

    def feed(self, delta: str) -> list[str]:
        self._buf += delta
        out: list[str] = []
        while True:
            if self._in_fence:
                close = self._buf.find("```")
                if close < 0:
                    return out
                self._buf = self._buf[close + 3:]
                self._in_fence = False
                continue
            fence = self._buf.find("```")
            m = self._END.search(self._buf)
            if fence >= 0 and (m is None or fence < m.start()):
                if self._buf[:fence].strip():
                    out.append(self._buf[:fence])
                self._buf = self._buf[fence + 3:]
                self._in_fence = True
                continue
            if m is None:
                return out
            if self._buf[:m.end()].strip():
                out.append(self._buf[:m.end()])
            self._buf = self._buf[m.end():]

    def flush(self) -> list[str]:
        rest, self._buf = ("" if self._in_fence else self._buf), ""
        self._in_fence = False
        return [rest] if rest.strip() else []


def _piper_synth_factory(voice_path: str):
    """Load the voice once, in-process: 0.06 s per sentence instead of the
    0.75 s a piper-tts process spends reloading the model on every call.
    Falls back to the piper-tts CLI if the module is not importable."""
    try:
        from piper import PiperVoice
        voice = PiperVoice.load(voice_path)
    except Exception:
        def cli(text: str, wav: str) -> bool:
            # Never --output-raw: it leaves -f empty and playback is silence.
            r = subprocess.run(["piper-tts", "-m", voice_path, "-f", wav],
                               input=text.encode(), capture_output=True)
            return r.returncode == 0
        return cli

    def inproc(text: str, wav: str) -> bool:
        with wave.open(wav, "wb") as w:
            voice.synthesize_wav(text, w)
        return True
    return inproc


class Speaker:
    """Speak a reply while it is still streaming, and stop the moment asked.

    Complete sentences go to a synthesis thread, finished WAVs to a playback
    thread, so sentence two is synthesised while sentence one plays. stop()
    kills playback and drops everything queued (barge-in): anything tagged
    with an older generation is discarded rather than spoken late.
    """

    def __init__(self, voice_path: str, synth_factory=_piper_synth_factory,
                 player: list[str] | None = None) -> None:
        import queue
        import threading

        self.voice_path = voice_path
        self._factory = synth_factory
        self._synth = None
        self._synth_ready = threading.Event()
        self._player = player or ["pw-play"]
        self._text_q: queue.Queue = queue.Queue()
        self._wav_q: queue.Queue = queue.Queue()
        self._lock = threading.Lock()
        self._gen = 0
        self._n = 0
        self._busy = 0
        self._play: subprocess.Popen | None = None
        self._splitter = SentenceSplitter()
        self.first_audio: float | None = None
        self._started_at: float | None = None
        self._first_event = threading.Event()
        threading.Thread(target=self._load, daemon=True).start()
        threading.Thread(target=self._synth_loop, daemon=True).start()
        threading.Thread(target=self._play_loop, daemon=True).start()

    def _load(self) -> None:
        self._synth = self._factory(self.voice_path)
        self._synth_ready.set()

    def set_voice(self, voice_path: str) -> None:
        self.stop()
        self.voice_path = voice_path
        self._synth_ready.clear()
        self._load()

    def begin(self) -> None:
        """Start of a reply: timing for first_audio is measured from here."""
        self._splitter = SentenceSplitter()
        self.first_audio = None
        self._first_event.clear()
        self._started_at = time.time()

    def _put(self, piece: str) -> None:
        text = for_speech(piece)
        if text:
            with self._lock:
                self._busy += 1
                self._text_q.put((self._gen, text))

    def feed(self, delta: str) -> None:
        for piece in self._splitter.feed(delta):
            self._put(piece)

    def finish(self) -> None:
        for piece in self._splitter.flush():
            self._put(piece)

    def say(self, text: str) -> None:
        """Speak a whole text (used for agent replies and error notices)."""
        self.begin()
        self.feed(text)
        self.finish()

    def _done_one(self) -> None:
        with self._lock:
            self._busy = max(0, self._busy - 1)

    def _synth_loop(self) -> None:
        while True:
            gen, text = self._text_q.get()
            self._synth_ready.wait()
            if gen != self._gen:
                self._done_one()
                continue
            self._n += 1
            wav = os.path.join(session_dir(), f"say-{self._n}.wav")
            try:
                ok = self._synth(text, wav)
            except Exception:
                ok = False
            if ok and gen == self._gen:
                self._wav_q.put((gen, wav))
            else:
                self._done_one()

    def _play_loop(self) -> None:
        while True:
            gen, wav = self._wav_q.get()
            if gen == self._gen:
                with self._lock:
                    self._play = subprocess.Popen(
                        [*self._player, wav], stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL)
                    proc = self._play
                if self.first_audio is None and self._started_at is not None:
                    self.first_audio = time.time() - self._started_at
                    self._first_event.set()
                proc.wait()
                with self._lock:
                    self._play = None
            try:
                os.remove(wav)
            except OSError:
                pass
            self._done_one()

    def busy(self) -> bool:
        with self._lock:
            return self._busy > 0

    def stop(self) -> None:
        """Silence now and drop everything queued."""
        with self._lock:
            self._gen += 1
            if self._play is not None:
                try:
                    self._play.kill()
                except Exception:
                    pass
        self._splitter = SentenceSplitter()

    def wait_first_audio(self, timeout: float) -> float | None:
        self._first_event.wait(timeout)
        return self.first_audio

    def wait_idle(self, timeout: float = 60) -> None:
        end = time.time() + timeout
        while self.busy() and time.time() < end:
            time.sleep(0.05)


