        # {year} is filled in per request (tools_for()). Measured: without it
        # qwen3.5:9b searched "who won the Masters this year 2024" in 2026.
        "description": "Search the web for current or specific facts: news, sports, "
                       "prices, events, anything after your training or that you are "
                       "unsure of. It is {year}: for anything recent put {year} in the "
                       "query, never an older year you remember. Returns result "
                       "titles, URLs and snippets.",
        "parameters": {"type": "object",
                       "properties": {"query": {"type": "string",
                                                "description": "search terms"}},
                       "required": ["query"]}}},
    {"type": "function", "function": {
        "name": "grow_status",
        "description": "Current readings from the user's grow setup: the AC Infinity "
                       "controller (tent temperature, humidity, VPD, fan ports; its "
